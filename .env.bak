# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-api03-3hP

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
MAX_CONCURRENT_AGENTS=5

# Agent Configuration (Direct Anthropic API)
# Using Claude Sonnet 4.5 (Latest version)
ORCHESTRATOR_MODEL=claude-sonnet-4-5
DESIGN_AGENT_MODEL=claude-sonnet-4-5
PALETTE_AGENT_MODEL=claude-sonnet-4-5
DETAIL_AGENT_MODEL=claude-sonnet-4-5
ANIMATION_AGENT_MODEL=claude-sonnet-4-5

# Output Configuration
OUTPUT_DIR=./output
ASSET_DIR=./assets
TEMP_DIR=./temp

# Performance Configuration
ENABLE_CACHING=true
CACHE_TTL=3600
MAX_RETRIES=3
TIMEOUT=300

# GitHub Integration (optional)
GITHUB_TOKEN=
GITHUB_REPO=

# Monitoring (optional)
ENABLE_TELEMETRY=false
SENTRY_DSN=