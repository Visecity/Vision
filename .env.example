# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-... (do not commit actual keys to Git)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
MAX_CONCURRENT_AGENTS=5

# Agent Configuration
# Model: claude-sonnet-4-5-20250929 (latest Claude Sonnet 4.5)
ORCHESTRATOR_MODEL=claude-sonnet-4-5-20250929
DESIGN_AGENT_MODEL=claude-sonnet-4-5-20250929
PALETTE_AGENT_MODEL=claude-sonnet-4-5-20250929
DETAIL_AGENT_MODEL=claude-sonnet-4-5-20250929
ANIMATION_AGENT_MODEL=claude-sonnet-4-5-20250929

# Output Configuration
OUTPUT_DIR=./output
ASSET_DIR=./assets
TEMP_DIR=./temp

# Performance Configuration
ENABLE_CACHING=true
CACHE_TTL=604800  # 7 days (recommended for optimal cache hit rate)
MAX_RETRIES=3
TIMEOUT=300

# GitHub Integration (optional)
GITHUB_TOKEN=
GITHUB_REPO=

# Monitoring (optional)
ENABLE_TELEMETRY=false
SENTRY_DSN=