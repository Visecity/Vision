# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
MAX_CONCURRENT_AGENTS=5

# Agent Configuration
ORCHESTRATOR_MODEL=claude-3-5-sonnet-20241022
DESIGN_AGENT_MODEL=claude-3-5-sonnet-20241022
PALETTE_AGENT_MODEL=claude-3-5-sonnet-20241022
DETAIL_AGENT_MODEL=claude-3-5-sonnet-20241022
ANIMATION_AGENT_MODEL=claude-3-5-sonnet-20241022

# Output Configuration
OUTPUT_DIR=./output
ASSET_DIR=./assets
TEMP_DIR=./temp

# Performance Configuration
ENABLE_CACHING=true
CACHE_TTL=3600
MAX_RETRIES=3
TIMEOUT=300

# GitHub Integration (optional)
GITHUB_TOKEN=
GITHUB_REPO=

# Monitoring (optional)
ENABLE_TELEMETRY=false
SENTRY_DSN=